  "tool.curve3.title": "Curve through points",
  "@tool.curve3.title": {
    "description": "UI text of the \"Curve through points\" tool in ConstructIt, a parametric 2D/3D CAD program; toolbar section \"curves\". These strings are the tool's button label, the help sentence shown while it is armed, and the names of the things it asks the user to click. What the tool does: Click the points in space the curve runs through — height points, or ordinary points, which lie in the plane they were drawn on; an existing one is shared, empty space places a new one.",
    "x-translated": "c9e6f533"
  },
  "tool.curve3.help": "Click the points in space the curve runs through — height points, or ordinary points, which lie in the plane they were drawn on; an existing one is shared, empty space places a new one. Press Enter to finish, or click the first point again to close the curve. The points are shared, so dragging one (or retyping its height) moves the curve; switch the sketch plane between clicks and the picks are kept.",
  "@tool.curve3.help": {
    "description": "UI text of the \"Curve through points\" tool in ConstructIt, a parametric 2D/3D CAD program; toolbar section \"curves\". These strings are the tool's button label, the help sentence shown while it is armed, and the names of the things it asks the user to click. What the tool does: Click the points in space the curve runs through — height points, or ordinary points, which lie in the plane they were drawn on; an existing one is shared, empty space places a new one.",
    "x-translated": "a0ffabc8"
  },
